# Plantilla de variables de entorno. Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
# Este archivo SÍ se sube a git; el .env no.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/spring_api
DB_USERNAME=tu-usuario
DB_PASSWORD=tu-password

# --- Seguridad (JWT en cookies HttpOnly) ---
# Clave HMAC en Base64, mínimo 256 bits. Genera una con: openssl rand -base64 32
JWT_SECRET=pega-aqui-la-clave-generada
# false para probar con Postman/curl sobre http://localhost; en producción (HTTPS) déjalo en true.
JWT_COOKIE_SECURE=false

# --- Administrador inicial (se crea al arrancar si no existe) ---
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-password
